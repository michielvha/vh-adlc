{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "origins": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entry_urls": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pages": {
      "minItems": 1,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "requested_url": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "initial",
                  "rendered"
                ]
              },
              "observed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "outcome": {
                "type": "string",
                "const": "captured"
              },
              "final_url": {
                "type": "string"
              },
              "status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "content_type": {
                "type": "string",
                "minLength": 1
              },
              "headers": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "body_file": {
                "type": "string",
                "minLength": 1
              },
              "redirects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 300,
                      "maximum": 399
                    }
                  },
                  "required": [
                    "from",
                    "to",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "requested_url",
              "mode",
              "observed_at",
              "outcome",
              "final_url",
              "status",
              "content_type",
              "headers",
              "body_file"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "requested_url": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "initial",
                  "rendered"
                ]
              },
              "observed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "outcome": {
                "type": "string",
                "const": "failed"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "requested_url",
              "mode",
              "observed_at",
              "outcome",
              "reason"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "requested_url": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "initial",
                  "rendered"
                ]
              },
              "observed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "outcome": {
                "type": "string",
                "const": "not_collected"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "requested_url",
              "mode",
              "observed_at",
              "outcome",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "files": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "sitemap_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "groups": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "extraction": {
      "type": "object",
      "properties": {
        "main_selector": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "main_selector"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "captured_at",
    "origins",
    "entry_urls",
    "pages",
    "files"
  ],
  "additionalProperties": false
}
