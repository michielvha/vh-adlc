        "source": "local",
        "path": "./plugins/vh-adlc"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    },
    {
      "name": "auth-refresh",
      "source": {
        "source": "url",
